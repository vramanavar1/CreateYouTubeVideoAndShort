# Copy to .env and fill in. NEVER commit .env or any real secret value.
# In a deployed environment these come from Azure Key Vault via env vars, not from a file.

# ---------------------------------------------------------------------------
# Credential storage
# ---------------------------------------------------------------------------
# file     = local token.json, written by `ytshort auth login`  (development)
# keyvault = refresh token read from Key Vault, never written to disk (Azure)
YTSHORT_CREDENTIAL_STORE=file

# Only read when YTSHORT_CREDENTIAL_STORE=keyvault.
YTSHORT_KEY_VAULT_URI=
YTSHORT_KV_SECRET_REFRESH_TOKEN=google-refresh-token
YTSHORT_KV_SECRET_CLIENT_ID=google-client-id
YTSHORT_KV_SECRET_CLIENT_SECRET=google-client-secret

# ---------------------------------------------------------------------------
# Google OAuth (file store only -- Gmail + YouTube share one installed-app client)
# ---------------------------------------------------------------------------
# Absolute path to the OAuth *client secret* JSON downloaded from Google Cloud
# Console (APIs & Services > Credentials > OAuth client ID > Desktop app).
# Keep this file OUTSIDE the repository.
YTSHORT_GOOGLE_CLIENT_SECRET_FILE=C:/secrets/ytshort/client_secret.json

# Where the token is cached after the first consent. Also keep this outside the
# repository -- it is a bearer credential. It never goes to Azure; only the
# refresh token it contains does. See `ytshort auth export`.
YTSHORT_GOOGLE_TOKEN_FILE=C:/secrets/ytshort/token.json

# ---------------------------------------------------------------------------
# Gmail ingestion
# ---------------------------------------------------------------------------
# Gmail search query used to discover candidate emails. No 'is:unread': the app
# holds gmail.readonly and cannot mark mail read. The date bound keeps the
# listing small; deduplication is done against the job store.
YTSHORT_GMAIL_QUERY=has:attachment newer_than:7d

# MANDATORY. Only mail from these addresses is processed. Comma separated.
# The app refuses to start when this is empty -- an empty allow-list means any
# stranger who emails the watched mailbox can queue media for publication.
YTSHORT_ALLOWED_SENDERS=

# PRD guardrails.
YTSHORT_MAX_EMAILS_PER_DAY=10
YTSHORT_MAX_TOTAL_ATTACHMENT_BYTES=20971520

# ---------------------------------------------------------------------------
# Media composition
# ---------------------------------------------------------------------------
# Leave blank to auto-discover ffmpeg/ffprobe on PATH.
YTSHORT_FFMPEG_PATH=
YTSHORT_FFPROBE_PATH=

# Directory of licensed background tracks (.mp3/.m4a/.wav). You supply these.
YTSHORT_AUDIO_DIR=assets/audio
YTSHORT_BUMPER_SECONDS=1.5
YTSHORT_MAX_SHORT_SECONDS=180
YTSHORT_BACKGROUND_AUDIO_GAIN=0.35

# ---------------------------------------------------------------------------
# Safety / PII policy
# ---------------------------------------------------------------------------
# Treat detected PII as: block (quarantine the job) or warn (surface in review).
YTSHORT_PII_POLICY=warn

# Malware scanner: defender | virustotal | none
#   defender   - Windows on-demand scan. Local development only; the deployed
#                Linux container has no Defender.
#   virustotal - reputation lookup by SHA-256. Only the hash is sent, never the
#                file. A hash nobody has submitted is reported as *not screened*
#                rather than clean. This is the deployed default.
#   none       - no scanning; every job carries a malware.not_scanned warning.
YTSHORT_MALWARE_SCANNER=defender
# Free tier is ample at 10 files/day. From Key Vault in Azure.
VIRUSTOTAL_API_KEY=
# Image moderation provider: none | claude
YTSHORT_MODERATION_PROVIDER=none
# Only read when YTSHORT_MODERATION_PROVIDER=claude.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Publishing
# ---------------------------------------------------------------------------
# private | unlisted | public. Keep 'private' until the Google Cloud project has
# passed YouTube's compliance audit -- unaudited projects have their uploads
# force-locked to private regardless of what is requested here.
YTSHORT_PRIVACY_STATUS=private
YTSHORT_VIDEO_CATEGORY_ID=22
YTSHORT_VIDEO_TAGS=shorts,automated

# ---------------------------------------------------------------------------
# Distribution sinks
# ---------------------------------------------------------------------------
# Comma separated: file,email
YTSHORT_SINKS=file,email
# Recipients for the email sink. Comma separated. Required if 'email' is enabled.
YTSHORT_EMAIL_RECIPIENTS=

# ---------------------------------------------------------------------------
# Review UI
# ---------------------------------------------------------------------------
YTSHORT_REVIEW_HOST=127.0.0.1
YTSHORT_REVIEW_PORT=8080

# none     = no authentication; ONLY safe bound to loopback (development)
# platform = a gateway authenticates in front of the app (Container Apps EasyAuth)
# Setting 'platform' without a gateway publishes an approve-anything button.
YTSHORT_AUTH_MODE=none

# Signing secret for the CSRF double-submit token. Leave empty locally (a random
# per-process value is used). In Azure this comes from Key Vault so open forms
# survive restarts and scale-to-zero.
YTSHORT_CSRF_SECRET=

# ---------------------------------------------------------------------------
# Job trigger -- lets the review app ask the scheduled Job to run now, so the
# internet-facing app never needs a Google credential of its own.
# ---------------------------------------------------------------------------
YTSHORT_JOB_TRIGGER_ENABLED=false
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
YTSHORT_AZURE_JOB_NAME=

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
YTSHORT_DATA_DIR=var
YTSHORT_LOG_LEVEL=INFO
# json | console
YTSHORT_LOG_FORMAT=console
# Off in Azure: the container's stderr is already collected into Log Analytics.
YTSHORT_LOG_TO_FILE=true
# Days to keep rendered media for finished jobs. Job records are kept regardless.
YTSHORT_MEDIA_RETENTION_DAYS=30
